# Supabase — local development points at the CLI stack (http://127.0.0.1:54321).
# Staging and production values come from the Supabase dashboard and live in
# Vercel, not in this file (see docs/RUNBOOK.md).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_ and never import in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Used only by scripts/seed.ts. Comma-separated; one admin is normal.
# The password is chosen by the operator, so admins are NOT forced to change it.
# No site URL variable on purpose: add one only when a feature actually reads it.
SEED_ADMIN_EMAILS=
SEED_ADMIN_PASSWORD=

# How much data the seed creates:
#   demo    admins + 5 dummy members + 3 sample questions + submissions/grades
#   starter admins + ONE real question, no members  <- launch shape
#   admins  admins only
# Unset means demo. SEED_ONLY_ADMINS=1 is an older alias for `admins`.
# SEED_PROFILE=starter

# Only `starter`: the WIB calendar date for its question, YYYY-MM-DD.
# Unset means "the date whose 04.00-04.00 window contains now", so the question
# is open the moment you seed.
# SEED_QUESTION_DATE=2026-11-16

# scripts/seed.ts refuses to run against a non-local project unless this is 1.
# That refusal is the guard against seeding dummy data into production — only
# set it when you are certain which project you are pointing at.
# SEED_ALLOW_REMOTE=1
