# Supabase (use the STAGING project locally and for Vercel previews)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_ and never import in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Used only by scripts/seed.ts to create the 2 first admins (comma-separated emails).
# SEED_ADMIN_PASSWORD is temporary: each admin must change it at first login.
# No site URL variable on purpose: add one only when a feature actually reads it.
SEED_ADMIN_EMAILS=
SEED_ADMIN_PASSWORD=
