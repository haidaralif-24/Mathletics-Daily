# Supabase (use the STAGING project locally and for Vercel previews)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_ and never import in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Used only by scripts/seed.ts to create the 2 first admins (comma-separated emails).
# SEED_ADMIN_PASSWORD is temporary: each admin must change it at first login.
# No site URL variable on purpose: add one only when a feature actually reads it.
SEED_ADMIN_EMAILS=
SEED_ADMIN_PASSWORD=

# Production has no dummy members and no sample questions. Set this to 1 to
# create only the admin accounts and stop (see docs/RUNBOOK.md step 7).
# SEED_ONLY_ADMINS=1

# scripts/seed.ts refuses to run against a non-local project unless this is 1.
# That refusal is the guard against seeding dummy data into production — only
# set it when you are certain which project you are pointing at.
# SEED_ALLOW_REMOTE=1
